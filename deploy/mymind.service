[Unit]
Description=MyMind (Nuxt/Nitro) native app
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/mymind
# Parity with the old docker runtime stage (which set ENV NODE_ENV=production).
Environment=NODE_ENV=production
# Cycle 81: no AGENT_RUNTIME_EXCLUSIVE here — the web never executes agent runs or runs boot
# recovery; apps/worker (mymind-worker.service) is the only executor and carries it.
# .env first, then .env.native overrides (DB/searxng/storage/host) — order matters.
EnvironmentFile=/opt/mymind/.env
EnvironmentFile=/opt/mymind/.env.native
ExecStart=/usr/bin/node /opt/mymind/.output/server/index.mjs
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
