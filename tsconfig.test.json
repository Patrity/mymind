{
  // `nuxt typecheck` only covers app/server/shared — test/ was never type-checked, so type lies in
  // tests passed every gate. This extends Nuxt's generated server config (Nitro auto-import globals,
  // ~~ aliases) and adds test/ (noUncheckedIndexedAccess off for tests: `arr[0].x` after an expect is idiomatic there; product code keeps it on). Run by `pnpm typecheck` (needs .nuxt, generated by `nuxt prepare`).
  "extends": "./.nuxt/tsconfig.server.json",
  "compilerOptions": { "noEmit": true, "noUncheckedIndexedAccess": false },
  "include": ["./.nuxt/types/nitro-nuxt.d.ts", "./.nuxt/types/nitro.d.ts", "./shared/**/*.d.ts", "./test/**/*.ts"],
  "exclude": ["./node_modules", "./.claude", "./test/nuxt/**", "./test/fixtures/**"]
}
