# Database
DATABASE_URL=postgres://mymind:mymind@localhost:5433/mymind

# Auth
BETTER_AUTH_SECRET=change-me-32-bytes-min
BETTER_AUTH_URL=http://localhost:3000
# Sign-up is disabled by default (single-user, internet-exposed). Set to true
# ONLY to bootstrap your account, then remove it. trustedOrigins derives from BETTER_AUTH_URL.
ALLOW_SIGNUP=

# Google connections (Settings → Connections; Gmail/Calendar/Contacts for Bridget). Optional —
# unset = feature off. Setup checklist: docs/DEPLOYMENT.md §20 (Google connections).
# NUXT_GOOGLE_CLIENT_ID=
# NUXT_GOOGLE_CLIENT_SECRET=

# AI providers/models are configured in the app at /settings (stored encrypted in the DB).
# Optional: a 32-byte base64 key to encrypt provider API keys. If unset, a key is
# derived from BETTER_AUTH_SECRET. Set this only if you want key rotation independent of auth.
# CONFIG_ENC_KEY=

# Memory: auto-review (skip human review) when extraction confidence >= this (default 0.75)
MEMORY_AUTO_REVIEW_THRESHOLD=0.75

# Storage
STORAGE_DRIVER=local
# STORAGE_LOCAL_DIR must be a PERSISTENT, writable path (mount a volume in prod). Holds uploaded blobs.
STORAGE_LOCAL_DIR=./.data/uploads
# S3 driver (set STORAGE_DRIVER=s3 to use): endpoint/region/bucket/keys
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=
STORAGE_S3_BUCKET=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=

# Upload limits
# MAX_UPLOAD_BYTES: max accepted upload size in bytes (default 52428800 = 50 MB)
MAX_UPLOAD_BYTES=52428800

# Server (Nitro node-server): port/host the app listens on
NITRO_PORT=3000
NITRO_HOST=0.0.0.0

# Search — Brave Search API only. The API key and rate limit (search.brave.qps) are set in-app at
# /settings → Search; no env vars.

# --- Agent exec tool (B3.2 — native-root model) ---
# Exec runs natively as root in LXC 114 (no setpriv / no agent uid drop / no /workspace jail).
# Secrets are stored encrypted in the DB (settings key exec_secrets); manage at /settings -> Secrets.
# Enable: powerful profile + agent-exec-enabled cookie in the /agent UI (off by default; no env toggle).
# EXEC_WORKSPACE_DIR=/opt/mymind/workspace  # default cwd for exec children (created by provision-native.sh)
# EXEC_TIMEOUT_MS=60000        # per-command wall-clock timeout
# APPROVAL_TIMEOUT_MS=120000   # how long an approval prompt waits before auto-deny
# EXEC_UNCONFINED is a DEV-ONLY escape hatch (non-root dev machines, NODE_ENV != production) — never set in prod.
# EXEC_AGENT_UID / EXEC_AGENT_GID — RETIRED in B3.2; no uid drop occurs.

# --- Agent worker (cycle 81) ---
# The web app and the agent worker (apps/worker; systemd unit mymind-worker — the ONLY process that
# executes agent runs) read this from the SAME runtime env and must agree. Read at runtime (never
# baked into the web build).
# MYMIND_BUS_NS: Postgres bus namespace ([A-Za-z0-9_-]{1,64}, default `default`). Only set it to keep
#   a second web+worker pair on the SAME database (a test rig, a worktree) from seeing this pair's
#   commands, run events and live updates.
# MYMIND_BUS_NS=
# Worker timings (ms): runtime tick, heartbeat, SIGTERM drain budget for in-flight runs.
# WORKER_TICK_MS=5000
# WORKER_BEAT_MS=5000
# WORKER_DRAIN_MS=60000

# --- Native LXC deploy (B3.1) ---
# When the app runs natively (systemd) instead of docker-compose, these overrides live in
# /opt/mymind/.env.native (gitignored via .env.*, written by deploy/provision-native.sh) and
# are loaded by the unit AFTER this file so they win:
#   DATABASE_URL=postgres://mymind:<POSTGRES_PASSWORD>@127.0.0.1:5432/mymind
#   STORAGE_LOCAL_DIR=/opt/mymind/.data/uploads
#   NITRO_PORT=3000
#   NITRO_HOST=0.0.0.0   # bind all ifaces so the (off-LXC) reverse proxy reaches it by LXC IP
#   # runtimeConfig keys (databaseUrl/storageLocalDir in nuxt.config) are BAKED at build from the
#   # build-time .env (=> @db). At RUNTIME only NUXT_*-prefixed vars override them — a plain
#   # DATABASE_URL does NOT. So the app needs these too, or it dials the build-baked DB and 500s:
#   NUXT_DATABASE_URL=postgres://mymind:<POSTGRES_PASSWORD>@127.0.0.1:5432/mymind
#   NUXT_STORAGE_LOCAL_DIR=/opt/mymind/.data/uploads

