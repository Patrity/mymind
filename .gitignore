.superpowers/

# One-time script artifacts: memory/label dumps produced by scripts/*.ts.
# These carry raw memory CONTENTS — personal data, and in one case a live API
# key that GitHub push protection caught on the way to this PUBLIC repo.
# Keep them local; never commit them.
scripts/data/*
# …except the reflector eval set (cycle 76): synthetic transcripts, no personal data.
!scripts/data/reflect-eval.jsonl
# …and the extract-v3 memory eval set (cycle 77): hand-written synthetic transcripts.
!scripts/data/memory-eval-v3.jsonl
