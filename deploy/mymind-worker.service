[Unit]
Description=MyMind agent worker (runs, runtime tick, agent scheduled tasks)
# Same host deps as the web unit. Ordered after it only so a cold boot brings the web up first; the
# worker does not need the web to be running (they talk through Postgres).
After=network-online.target docker.service mymind.service
Wants=network-online.target

[Service]
Type=simple
User=root
# cwd matters: relative paths in the shared env (e.g. a default ./.data/uploads) resolve from here,
# exactly as they do for the web unit.
WorkingDirectory=/opt/mymind
Environment=NODE_ENV=production
# Recovery may take over any 'running' run claimed by a previous boot, however fresh (cycle 73, I4).
# Safe because exactly one process executes against the prod DB: whichever AGENT_EXECUTOR names
# (the other one never runs boot recovery). Never set this where other processes share the DB.
Environment=AGENT_RUNTIME_EXCLUSIVE=1
# The SAME env as the web unit, in the same order — the worker maps it with core's fromEnv, which
# applies the same NUXT_* overrides the web sees (NUXT_DATABASE_URL etc.), plus MYMIND_BUS_NS and
# AGENT_EXECUTOR, which both processes must agree on.
EnvironmentFile=/opt/mymind/.env
EnvironmentFile=/opt/mymind/.env.native
# The ACTIVE release (deploy/worker-release.sh): bundle + its own node_modules, outside the tree CD
# clears and the node_modules `pnpm install` rewrites, so a restart mid-deploy still finds it whole.
ExecStart=/usr/bin/node /opt/mymind/.worker/dist/worker.mjs
# Graceful drain: SIGTERM goes to the worker only (KillMode=mixed) — not to exec-tool children it is
# still waiting on — and it gets up to 60s (WORKER_DRAIN_MS) to let in-flight runs finish before it
# exits; systemd SIGKILLs whatever is left after TimeoutStopSec.
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=90
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
